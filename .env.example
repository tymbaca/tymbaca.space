# Directory with article folders, relative to the process working directory.
# CONTENT_DIR=contents

# Set to "true" to publish articles with "draft": true in md.json.
# SHOW_DRAFTS=false

# Base URL of the backend HTTP gateway (view counter proxy).
# BACKEND_URL=http://localhost:8080

# adapter-node runtime options (optional):
# PORT=3000
# ORIGIN=https://tymbaca.space
